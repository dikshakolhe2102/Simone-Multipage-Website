<%- include('header.ejs'); %>
    <div class="main">
        <header class="topbar">
        <h2>Add Work Record</h2>
        <div class="user">Welcome, Admin</div>
        </header>

        <section class="content">
        <div class="panel">
            <h3>Work form</h3>

            <form class="form" action="/admin/work_save" method="post" enctype="multipart/form-data">
            <div class="row">
                <div class="field">
                <label for="w_img">Work Image</label>
                <input id="w_img" type="file" name="w_img" />
                </div>
                <div class="field">
                <label for="text">Work Title</label>
                <input id="text" type="text" name="w_title" placeholder="Title" />
                </div>
                <div class="field">
                <label for="notes">Work Description</label>
                <textarea id="notes" type="text" name="w_desc" placeholder="Short Note" ></textarea>
                </div>
            </div>

            <div class="actions">
                <button class="btn" type="submit">Save</button>
                <button class="btn btn-ghost" type="reset">Clear</button>
            </div>
            </form>
        </div>
        </section>
    </div>
    </div>
<%- include('footer.ejs'); %>
