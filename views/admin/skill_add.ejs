<%- include('header.ejs'); %>
    <div class="main">
        <header class="topbar">
        <h2>Add Skill Record</h2>
        <div class="user">Welcome, Admin</div>
        </header>

        <section class="content">
        <div class="panel">
            <h3>Skill form</h3>

            <form class="form" action="/admin/skill_save" method="post">
            <div class="row">
                <div class="field">
                <label for="name">Skill Name</label>
                <input id="name" type="text" name="skill_n" placeholder="Skill Name" />
                </div>
                <div class="field">
                <label for="text">Skill Percentage(%)</label>
                <input id="text" type="text" name="skill_p" placeholder="Skill Percentage" />
                </div>
            </div>

            <div class="actions">
                <button class="btn" type="submit">Save</button>
                <button class="btn btn-ghost" type="reset">Clear</button>
            </div>
            </form>
        </div>
        </section>
    </div>
    </div>
<%- include('footer.ejs'); %>
