<%- include('header.ejs'); %>
    <div class="main">
        <header class="topbar">
        <h2>Add Home Update Record</h2>
        <div class="user">Welcome, Admin</div>
        </header>

        <section class="content">
        <div class="panel">
            <h3>Home Update form</h3>

            <form class="form" action="/admin/home_update_save/<%=data.hid%>/<%=data.h_img%>" method="post" enctype="multipart/form-data">
            <div class="row">
                <div class="field">
                <label for="name">Home Image</label>
                <input id="name" type="file" name="h_img" />
                <img src="/image/<%=data.h_img%>" height="50px" width="50px" />
                </div>

                <div class="field">
                <label for="text">Title1</label>
                <input id="text" type="text" name="h_title1" value="<%=data.h_title1%>" placeholder="Title1" />
                </div>

                <div class="field">
                <label for="text">Title2</label>
                <input id="text" type="text" name="h_title2" value="<%=data.h_title2%>" placeholder="Title2" />
                </div>

                <div class="field">
                <label for="text">Title3</label>
                <input id="text" type="text" name="h_title3" value="<%=data.h_title3%>" placeholder="Title3" />
                </div>

                <div class="field">
                    <label for="notes">Home Description</label>
                    <textarea id="notes" name="h_desc" placeholder="Short note..."><%=data.h_desc%>  </textarea>
                </div>

                <div class="actions">
                    <button class="btn" type="submit">Update</button>
                    <button class="btn btn-ghost" type="reset">Clear</button>
                </div>
            </div>
            </form>
        </div>
        </section>
    </div>
    </div>
<%- include('footer.ejs'); %>
