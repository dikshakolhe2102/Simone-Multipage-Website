<%- include('header.ejs'); %>
      <div class="main">
        <header class="topbar">
          <h2>Add Services Record</h2>
          <div class="user">Welcome, Admin</div>
        </header>

        <section class="content">
          <div class="panel">
            <h3>Education form</h3>

            <form class="form" action="/admin/education_save" method="post">
              <div class="row">
                <div class="field">
                  <label for="name">Education Year</label>
                  <input id="name" type="text" name="e_year" placeholder="education year" />
                </div>
                <div class="field">
                  <label for="text">Education Name</label>
                  <input id="text" type="text" name="e_name" placeholder="Education Name" />
                </div>
              </div>


              <div class="field">
                <label for="notes">Education University</label>
                <textarea id="notes" name="e_uni" placeholder="University"></textarea>
              </div>

              <div class="field">
                <label for="notes">Education Description</label>
                <textarea id="notes" name="s_desc" placeholder="Short note..."></textarea>
              </div>

              <div class="actions">
                <button class="btn" type="submit">Save</button>
                <button class="btn btn-ghost" type="reset">Clear</button>
              </div>
            </form>
          </div>
        </section>
      </div>
    </div>
<%- include('footer.ejs'); %>
