<%- include('header.ejs'); %>
 <section class="section section--alt" id="services">
      <div class="container">
        <div class="section-head">
          <div class="section-bg-title">Services</div>
          <h2 class="section-title">What I Do?</h2>
        </div>
        <div class="services">
          <% for(var i=0;i<data.length;i++) { %>
          <article class="service">
            <i class="<%= data[i].s_icons %>"></i>
            <h3><%= data[i].s_title %></h3>
            <p><%= data[i].s_desc %></p>
          </article>
          <% } %>
        </div>
      </div>
    </section>

<%- include('footer.ejs'); %>